{
    "extends": "./tsconfig.base.json",
    "compilerOptions": {
        "ignoreDeprecations": "6.0",
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "lib": ["ES2022", "DOM", "DOM.Iterable"],
        "jsx": "react-jsx",
        "types": ["vite/client"]
    },
    "include": [
        "src/renderer/src/**/*.ts",
        "src/renderer/src/**/*.tsx",
        "src/shared/**/*.ts",
        "src/shared/**/*.d.ts"
    ]
}
