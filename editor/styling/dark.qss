* {
    font-family: "Manrope";
    font-size: 12px;
    color: #E7ECF3;
    selection-background-color: #3F78D8;
    selection-color: #FFFFFF;
}

QWidget {
    background-color: #0D1117;
    color: #E7ECF3;
}

QMainWindow,
QDialog,
QFrame {
    background-color: #0D1117;
}

QLabel {
    background: transparent;
}

QLabel:disabled {
    color: #566174;
}

QToolTip {
    background-color: #202838;
    color: #F7F9FC;
    border: 1px solid #3A465A;
    border-radius: 3px;
    padding: 4px 6px;
}

QGroupBox {
    background-color: #141A23;
    border: 1px solid #252E3C;
    border-radius: 4px;
    margin-top: 14px;
    padding: 8px;
    color: #F1F4F8;
    font-weight: 650;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 9px;
    padding: 0 6px;
    color: #AEB8C8;
    background-color: #141A23;
}

QScrollArea,
QAbstractScrollArea {
    background-color: #10151C;
    border: none;
}

QAbstractScrollArea::corner {
    background-color: #10151C;
}

QScrollBar:vertical {
    background-color: transparent;
    width: 9px;
    margin: 2px;
    border: none;
}

QScrollBar:horizontal {
    background-color: transparent;
    height: 9px;
    margin: 2px;
    border: none;
}

QScrollBar::handle:vertical,
QScrollBar::handle:horizontal {
    background-color: #364154;
    border-radius: 3px;
    min-height: 30px;
    min-width: 30px;
}

QScrollBar::handle:vertical:hover,
QScrollBar::handle:horizontal:hover {
    background-color: #536078;
}

QScrollBar::add-line,
QScrollBar::sub-line,
QScrollBar::add-page,
QScrollBar::sub-page {
    background: none;
    border: none;
    width: 0;
    height: 0;
}

QPushButton,
QToolButton {
    background-color: #1A2230;
    border: 1px solid #2D3849;
    border-radius: 3px;
    padding: 3px 7px;
    color: #E9EDF4;
    min-height: 18px;
    font-weight: 550;
}

QPushButton:hover,
QToolButton:hover {
    background-color: #222C3C;
    border-color: #46536A;
}

QPushButton:pressed,
QToolButton:pressed {
    background-color: #121923;
    border-color: #4C8DFF;
}

QPushButton:checked,
QToolButton:checked {
    background-color: #182C4A;
    border-color: #4C8DFF;
    color: #FFFFFF;
}

QPushButton:default,
#primaryAction {
    background-color: #3F78D8;
    border-color: #6BA3FF;
    color: #FFFFFF;
    font-weight: 650;
}

QPushButton:default:hover,
#primaryAction:hover {
    background-color: #4C8DFF;
    border-color: #78A9F2;
}

QPushButton:disabled,
QToolButton:disabled {
    background-color: #121820;
    border-color: #1D2531;
    color: #566174;
}

QToolButton::menu-indicator {
    image: none;
}

QLineEdit,
QTextEdit,
QPlainTextEdit,
QComboBox,
QSpinBox,
QDoubleSpinBox,
QDateEdit,
QTimeEdit,
QDateTimeEdit {
    background-color: #0F141B;
    border: 1px solid #273141;
    border-radius: 3px;
    padding: 4px 6px;
    color: #EEF2F7;
}

QLineEdit:hover,
QTextEdit:hover,
QPlainTextEdit:hover,
QComboBox:hover,
QSpinBox:hover,
QDoubleSpinBox:hover {
    border-color: #3D4A60;
}

QLineEdit:focus,
QTextEdit:focus,
QPlainTextEdit:focus,
QComboBox:focus,
QSpinBox:focus,
QDoubleSpinBox:focus {
    background-color: #111824;
    border-color: #4C8DFF;
}

QLineEdit:disabled,
QTextEdit:disabled,
QComboBox:disabled,
QSpinBox:disabled,
QDoubleSpinBox:disabled {
    background-color: #11161D;
    border-color: #1D2530;
    color: #566174;
}

QComboBox {
    padding-right: 24px;
}

QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: top right;
    width: 22px;
    border-left: 1px solid #273141;
}

QComboBox QAbstractItemView {
    background-color: #171E29;
    border: 1px solid #344156;
    border-radius: 4px;
    padding: 3px;
    selection-background-color: #182C4A;
}

QAbstractSpinBox::up-button,
QAbstractSpinBox::down-button {
    background-color: #171F2B;
    border: none;
    width: 16px;
}

QAbstractSpinBox::up-button:hover,
QAbstractSpinBox::down-button:hover {
    background-color: #263144;
}

QCheckBox,
QRadioButton {
    spacing: 7px;
    color: #C9D1DE;
}

QCheckBox::indicator,
QRadioButton::indicator {
    width: 15px;
    height: 15px;
}

QSlider::groove:horizontal {
    background-color: #202A38;
    height: 4px;
    border-radius: 2px;
}

QSlider::handle:horizontal {
    background-color: #4C8DFF;
    border: 2px solid #A9C8F5;
    width: 12px;
    margin: -5px 0;
    border-radius: 7px;
}

QProgressBar {
    background-color: #151C26;
    border: 1px solid #293446;
    border-radius: 3px;
    height: 8px;
    text-align: center;
}

QProgressBar::chunk {
    background-color: #4C8DFF;
    border-radius: 3px;
}

QTreeView,
QListView,
QListWidget,
QTableView,
QTableWidget {
    background-color: #10151C;
    alternate-background-color: #121923;
    border: none;
    color: #DCE3EC;
    show-decoration-selected: 1;
}

QTreeView::item,
QListView::item,
QListWidget::item,
QTableView::item,
QTableWidget::item {
    border: 1px solid transparent;
    border-radius: 3px;
    padding: 3px 5px;
}

QTreeView::item:hover,
QListView::item:hover,
QListWidget::item:hover,
QTableView::item:hover,
QTableWidget::item:hover {
    background-color: #1A2230;
    border-color: #293548;
}

QTreeView::item:selected,
QListView::item:selected,
QListWidget::item:selected,
QTableView::item:selected,
QTableWidget::item:selected {
    background-color: #172A46;
    border-color: #3F78D8;
    color: #FFFFFF;
}

QHeaderView {
    background-color: #111720;
}

QHeaderView::section {
    background-color: #171E29;
    border: none;
    border-right: 1px solid #283243;
    border-bottom: 1px solid #283243;
    padding: 5px 7px;
    color: #98A4B7;
    font-weight: 600;
}

QTabWidget::pane {
    background-color: #10151C;
    border: 1px solid #273141;
    border-radius: 0 0 3px 3px;
}

QTabBar::tab {
    background-color: #111720;
    border: none;
    border-right: 1px solid #232C3A;
    border-bottom: 1px solid #273141;
    color: #7F8B9D;
    min-width: 88px;
    padding: 5px 9px;
}

QTabBar::tab:hover {
    background-color: #18202B;
    color: #C8D1DF;
}

QTabBar::tab:selected {
    background-color: #151C26;
    color: #F2F5F9;
    border-bottom: 2px solid #4C8DFF;
}

QMenuBar#atlasMenuBar {
    background-color: #090D12;
    border-bottom: 1px solid #202836;
    padding: 2px 6px;
}

QMenuBar#atlasMenuBar::item {
    background: transparent;
    color: #B8C2D0;
    padding: 5px 9px;
    border-radius: 3px;
}

QMenuBar#atlasMenuBar::item:selected,
QMenuBar#atlasMenuBar::item:pressed {
    background-color: #202838;
    color: #FFFFFF;
}

QMenu {
    background-color: #171E29;
    border: 1px solid #344156;
    border-radius: 4px;
    padding: 3px;
}

QMenu::item {
    background: transparent;
    border-radius: 3px;
    padding: 5px 30px 5px 8px;
    color: #DCE3EC;
}

QMenu::item:selected {
    background-color: #172A46;
    color: #FFFFFF;
}

QMenu::item:disabled {
    color: #596477;
}

QMenu::separator {
    background-color: #2A3444;
    height: 1px;
    margin: 5px 8px;
}

QSplitter::handle {
    background-color: #080C11;
}

QSplitter::handle:horizontal {
    width: 4px;
}

QSplitter::handle:vertical {
    height: 4px;
}

QSplitter::handle:hover {
    background-color: #4C8DFF;
}

QStatusBar {
    background-color: #090D12;
    border-top: 1px solid #202836;
    color: #8490A4;
}

#atlasStatusBar {
    min-height: 21px;
    padding: 0 6px;
}

#statusRuntimeIcon {
    padding: 0 4px;
}

#statusRenderer {
    background-color: #192B22;
    border: 1px solid #2C573B;
    border-radius: 4px;
    color: #8DE2A5;
    font-size: 9px;
    font-weight: 700;
    padding: 2px 6px;
}

#statusVersion {
    color: #68758A;
    font-size: 9px;
    padding: 0 6px;
}

#workspaceBar {
    background-color: #10151C;
    border: none;
    border-bottom: 1px solid #273141;
    spacing: 3px;
    padding: 2px 5px 2px 0;
}

#workspaceIdentity {
    background: transparent;
    border-right: 1px solid #2A3444;
}

#workspaceMark {
    background: transparent;
}

#workspaceBrand {
    color: #F5F7FA;
    font-size: 12px;
    font-weight: 800;
}

#workspaceProject {
    color: #7F8B9D;
    font-size: 11px;
}

#workspaceModeButton {
    background-color: transparent;
    border: 1px solid transparent;
    border-radius: 3px;
    color: #94A0B2;
    padding: 4px 8px;
    margin: 0 1px;
}

#workspaceModeButton:hover {
    background-color: #1B2431;
    color: #DDE4ED;
}

#workspaceModeButton:checked {
    background-color: #17263B;
    border-color: #31577F;
    color: #FFFFFF;
}

#workspaceUtilityButton {
    background: transparent;
    border-color: transparent;
    min-width: 26px;
    padding: 3px 5px;
}

#workspaceBuildButton,
#workspaceLaunchButton {
    min-width: 26px;
    padding: 3px 5px;
}

#workspaceBuildButton {
    background-color: #2C2618;
    border-color: #5D4B23;
    color: #F5D184;
}

#workspaceLaunchButton {
    background-color: #183020;
    border-color: #285A38;
    color: #92E6A9;
    margin-left: 3px;
}

#workspaceBuildButton:hover {
    background-color: #3A311D;
    border-color: #80682D;
}

#workspaceLaunchButton:hover {
    background-color: #20412A;
    border-color: #3A7A4B;
}

#sceneTabs {
    background-color: #0C1117;
    border-bottom: 1px solid #273141;
}

#sceneTabs::tab {
    background-color: #111720;
    border-right: 1px solid #252E3B;
    color: #7F8B9D;
    min-width: 112px;
    padding: 5px 10px;
}

#sceneTabs::tab:selected {
    background-color: #171E29;
    color: #F3F6FA;
    border-bottom: 2px solid #4CB7D8;
}

#viewportTools {
    background-color: #090D12;
}

#viewportToolbar {
    background-color: #111720;
    border-bottom: 1px solid #273141;
}

#viewportPlaybackButton,
#viewportModeButton,
#viewportOptionButton,
#viewportShadingButton {
    background-color: #171E29;
    border-color: #283345;
    min-width: 25px;
    min-height: 22px;
    padding: 3px 5px;
}

#viewportPlaybackButton:hover,
#viewportModeButton:hover,
#viewportOptionButton:hover,
#viewportShadingButton:hover {
    background-color: #222C3C;
    border-color: #46536A;
}

#viewportModeButton:checked,
#viewportShadingButton:checked {
    background-color: #172A46;
    border-color: #4C8DFF;
}

#viewportFpsLabel {
    color: #73C58A;
    font-size: 10px;
    font-weight: 650;
}

#viewportShortcutHint {
    background-color: #090D12;
    border-top: 1px solid #202836;
    color: #68758A;
    font-size: 10px;
    padding: 3px 7px;
}

#panelToolbar,
#materialEditorHeader,
#postProcessingToolbar,
#workspaceToolbar {
    background-color: #131922;
    border-bottom: 1px solid #283243;
    padding: 3px;
}

#panelAddButton,
#materialSaveButton,
#workspaceApplyButton {
    background-color: #172A46;
    border-color: #35628F;
    color: #DCE9FA;
}

#panelMoreButton,
#browserNavigationButton,
#browserRevealButton {
    background-color: transparent;
    border-color: transparent;
    min-width: 24px;
}

#panelMoreButton:hover,
#browserNavigationButton:hover,
#browserRevealButton:hover {
    background-color: #202A38;
    border-color: #334056;
}

#contentPathField {
    background-color: #0E131A;
    color: #8490A4;
    font-size: 11px;
}

#contentSearchField {
    min-width: 130px;
}

QTreeView#hierarchyTree {
    background-color: #10151C;
    border-top: 1px solid #202836;
    padding: 5px 3px;
}

QTreeView#hierarchyTree::item {
    min-height: 24px;
    padding: 3px 5px;
}

QTreeView#hierarchyTree::item:selected {
    background-color: #172A46;
    border-left: 2px solid #6BA3FF;
}

QListView#contentGrid {
    background-color: #0D1218;
    border-top: 1px solid #202836;
    padding: 6px;
}

QListView#contentGrid::item {
    background-color: #121923;
    border: 1px solid #202A38;
    border-radius: 4px;
    padding: 7px;
    color: #BCC6D4;
}

QListView#contentGrid::item:hover {
    background-color: #182130;
    border-color: #3A465A;
}

QListView#contentGrid::item:selected {
    background-color: #17283F;
    border-color: #4C8DFF;
    color: #FFFFFF;
}

QScrollArea#inspectorScroll,
#inspectorContent,
#materialEditorBody,
#postProcessingBody {
    background-color: #10151C;
    border: none;
}

#inspectorHeader {
    background-color: #141B25;
    border: 1px solid #273243;
    border-radius: 4px;
    padding: 6px;
}

#inspectorObjectIcon {
    background-color: #20283A;
    border: 1px solid #38455B;
    border-radius: 4px;
    padding: 4px;
}

#inspectorNameField {
    background: transparent;
    border: 1px solid transparent;
    color: #F3F6FA;
    font-size: 14px;
    font-weight: 700;
}

#inspectorNameField:hover,
#inspectorNameField:focus {
    background-color: #10151C;
    border-color: #46536A;
}

#inspectorTypeLabel {
    color: #7E8A9E;
    font-size: 10px;
    font-weight: 600;
}

#inspectorComponent {
    background-color: #141A23;
    border: 1px solid #252F3E;
    border-radius: 4px;
    margin-top: 3px;
}

#inspectorComponentHeaderRow {
    background-color: #171E29;
    border-bottom: 1px solid #252F3E;
    border-radius: 4px 4px 0 0;
}

#inspectorComponentHeader {
    background: transparent;
    border: none;
    color: #E8ECF2;
    font-weight: 650;
    text-align: left;
    padding: 5px 7px;
}

#inspectorComponentHeader:hover {
    background-color: #1D2634;
}

#inspectorComponentRemoveButton {
    background: transparent;
    border: none;
    min-width: 22px;
}

#inspectorComponentRemoveButton:hover {
    background-color: #43212A;
    border: 1px solid #713141;
}

#inspectorComponentBody {
    background-color: #141A23;
    padding: 5px;
}

#inspectorPropertyRow {
    background: transparent;
    min-height: 27px;
}

#inspectorPropertyLabel {
    color: #929EB0;
    font-size: 11px;
}

#inspectorVectorField,
#inspectorColorField,
#inspectorNumericField {
    background-color: #0F141B;
    border: 1px solid #263142;
    border-radius: 3px;
}

#inspectorVectorField QDoubleSpinBox,
#inspectorNumericField QDoubleSpinBox {
    background: transparent;
    border: none;
}

#inspectorAxisLabel {
    background-color: #202A38;
    border-radius: 3px;
    color: #AAB5C5;
    font-size: 9px;
    font-weight: 750;
    padding: 2px 4px;
}

#inspectorSyncButton,
#inspectorArrayButton {
    background: transparent;
    border-color: transparent;
    min-width: 22px;
}

#inspectorSyncButton[matched="true"] {
    background-color: #1C3827;
    border-color: #2F6841;
    color: #8FE1A6;
}

#inspectorColorSwatch {
    border: 1px solid #4A566A;
    border-radius: 4px;
}

#inspectorColorText {
    color: #9CA8BA;
    font-family: "Menlo";
    font-size: 10px;
}

#inspectorNestedGroup {
    background-color: #111720;
    border: 1px solid #222C3A;
    border-radius: 4px;
    margin: 3px 0;
    padding: 5px;
}

#inspectorNestedTitle,
#inspectorArrayTitle {
    color: #AEB8C8;
    font-weight: 650;
}

#inspectorEmptyTitle,
#materialEditorEmpty,
#postProcessingEmpty {
    color: #C4CDDA;
    font-size: 14px;
    font-weight: 650;
}

#inspectorEmptyHint {
    color: #728096;
}

#inspectorOpenAssetButton,
#inspectorAddComponentButton {
    background-color: #1B2431;
    border: 1px dashed #46536A;
    color: #C7D0DD;
    padding: 6px;
}

#inspectorAddComponentButton:hover {
    background-color: #17283F;
    border-color: #4C8DFF;
    color: #FFFFFF;
}

#inspectorAudioControls {
    background-color: #111720;
    border-radius: 3px;
}

#materialEditorTitle,
#postProcessingTitle,
#postProcessingSectionTitle,
#inspectorCameraTitle,
#workspaceTitle {
    color: #F3F6FA;
    font-size: 13px;
    font-weight: 700;
}

#materialEditorStatus,
#postProcessingStatus,
#workspaceStatus,
#workspaceAutoApply {
    color: #7E8A9E;
    font-size: 10px;
}

#materialPreview {
    background-color: #090D12;
    border: 1px solid #2B3648;
    border-radius: 4px;
}

#materialTextureSlot {
    background-color: #121923;
    border: 1px solid #263142;
    border-radius: 4px;
    padding: 4px;
}

#materialTexturePreview {
    background-color: #0D1218;
    border: 1px solid #344156;
    border-radius: 4px;
    color: #D9825B;
    font-weight: 750;
}

#materialTextureLabel {
    color: #D6DDE7;
    font-weight: 650;
}

#materialTexturePath {
    color: #7D899C;
}

#environmentPages,
#environmentWorkspace,
#environmentPage {
    background-color: #10151C;
    border: none;
}

QListWidget#environmentCategories {
    background-color: #0E131A;
    border-right: 1px solid #273141;
    padding: 5px;
}

QListWidget#environmentCategories::item {
    padding: 6px 8px;
    margin: 2px 0;
}

QListWidget#environmentCategories::item:selected {
    background-color: #172A46;
    border-left: 2px solid #6BA3FF;
}

#environmentPageTitle {
    color: #F3F6FA;
    font-size: 17px;
    font-weight: 750;
}

#environmentPageSubtitle {
    color: #778499;
}

QGroupBox#environmentSection {
    background-color: #141A23;
    border-color: #273141;
}

ads--CDockContainerWidget {
    background-color: #080C11;
}

ads--CDockContainerWidget > QSplitter {
    background-color: #080C11;
}

ads--CDockContainerWidget ads--CDockSplitter::handle {
    background-color: #080C11;
}

ads--CDockContainerWidget ads--CDockSplitter::handle:hover {
    background-color: #4C8DFF;
}

ads--CDockAreaWidget {
    background-color: #10151C;
    border: 1px solid #202A38;
}

ads--CDockAreaWidget[focused="true"] {
    border-color: #39465B;
}

ads--CDockAreaTitleBar {
    background-color: #111720;
    border-bottom: 1px solid #273141;
    min-height: 26px;
}

ads--CDockAreaWidget[focused="true"] ads--CDockAreaTitleBar {
    background-color: #151C27;
}

#tabsContainerWidget {
    background-color: transparent;
}

ads--CTitleBarButton {
    background: transparent;
    border: none;
    border-radius: 3px;
    min-width: 22px;
    min-height: 22px;
    padding: 2px;
}

ads--CTitleBarButton:hover {
    background-color: #263144;
}

ads--CDockWidgetTab {
    background-color: #111720;
    border: none;
    border-right: 1px solid #252E3B;
    border-bottom: 1px solid #273141;
    padding: 1px 5px;
}

ads--CDockWidgetTab:hover {
    background-color: #18212D;
}

ads--CDockWidgetTab[activeTab="true"] {
    background-color: #171E29;
    border-bottom: 2px solid #4C8DFF;
}

ads--CDockWidgetTab[focused="true"] {
    background-color: #1A2230;
}

ads--CDockWidgetTab #dockWidgetTabLabel {
    color: #7F8B9D;
    font-size: 11px;
    padding: 4px 2px;
}

ads--CDockWidgetTab[activeTab="true"] #dockWidgetTabLabel,
ads--CDockWidgetTab[focused="true"] #dockWidgetTabLabel {
    color: #F1F4F8;
}

#tabCloseButton,
#dockAreaCloseButton,
#detachGroupButton,
#dockAreaAutoHideButton,
#dockAreaMinimizeButton,
#tabsMenuButton {
    background: transparent;
    border: none;
    min-width: 20px;
    min-height: 20px;
}

#tabCloseButton:hover,
#dockAreaCloseButton:hover,
#detachGroupButton:hover,
#dockAreaAutoHideButton:hover,
#dockAreaMinimizeButton:hover,
#tabsMenuButton:hover {
    background-color: #2A3444;
}

ads--CDockWidget {
    background-color: #10151C;
}

ads--CAutoHideSideBar,
#sideTabsContainerWidget {
    background-color: #090D12;
}

ads--CAutoHideTab {
    background-color: #111720;
    border: 1px solid #263142;
    color: #7F8B9D;
    padding: 4px;
}

ads--CAutoHideTab:hover,
ads--CAutoHideTab[activeTab="true"] {
    background-color: #172A46;
    border-color: #3F78D8;
    color: #FFFFFF;
}

#projectBrowserRoot,
#projectBrowserContent {
    background-color: #0D1117;
}

#projectSidebar {
    background-color: #0A0E13;
    border-right: 1px solid #202836;
}

#projectBrand {
    color: #F5F7FA;
    font-size: 16px;
    font-weight: 750;
}

#projectSidebarVersion {
    color: #68758A;
    font-size: 10px;
    font-weight: 600;
}

#projectNavSelected {
    background-color: #17263B;
    border: 1px solid #2F527D;
    border-left: 3px solid #6BA3FF;
    color: #DCE9FA;
    padding: 6px 9px;
    text-align: left;
}

#projectNavSelected:disabled {
    color: #DCE9FA;
}

#projectBrowserTitle,
#dialogTitle {
    color: #F4F6FA;
    font-size: 24px;
    font-weight: 750;
}

#projectBrowserSubtitle,
#dialogSubtitle,
#emptyStateSubtitle,
#templateDescription {
    color: #7F8B9D;
}

#projectSearch {
    background-color: #111720;
    border: 1px solid #2A3547;
    border-radius: 4px;
    padding: 7px 9px;
    font-size: 13px;
}

#projectSearch:focus {
    border-color: #4C8DFF;
}

#projectList {
    background-color: transparent;
    border: none;
}

#projectList::item {
    background: transparent;
    border: none;
    padding: 0;
}

#projectRow {
    background-color: #141A23;
    border: 1px solid #252F3E;
    border-radius: 5px;
}

#projectRow:hover {
    background-color: #18212D;
    border-color: #40506A;
}

#projectRow[available="false"] {
    background-color: #11161D;
    border-color: #1D2530;
}

#projectIcon,
#templateIcon {
    background-color: #1D2532;
    border: 1px solid #334056;
    border-radius: 4px;
}

#projectName {
    color: #EEF2F7;
    font-size: 14px;
    font-weight: 700;
}

#projectPath,
#projectDate {
    color: #768398;
    font-size: 10px;
}

#rendererBadge {
    background-color: #1C3527;
    border: 1px solid #2C6340;
    border-radius: 3px;
    color: #8DE2A5;
    padding: 3px 7px;
    font-size: 9px;
    font-weight: 700;
}

#projectMoreButton {
    background: transparent;
    border-color: transparent;
}

#projectMoreButton:hover {
    background-color: #253044;
    border-color: #3B4860;
}

#projectEmptyState {
    background-color: #10151C;
    border: 1px dashed #2F3A4D;
    border-radius: 5px;
}

#emptyStateTitle {
    color: #CDD5E1;
    font-size: 16px;
    font-weight: 700;
}

#createProjectDialog {
    background-color: #10151C;
}

QFrame[templateCard="true"] {
    background-color: #141A23;
    border: 1px solid #293445;
    border-radius: 5px;
}

QFrame[templateCard="true"]:hover {
    background-color: #1A2230;
    border-color: #46536A;
}

QFrame[templateCard="true"][selected="true"] {
    background-color: #17283F;
    border-color: #4C8DFF;
}

#templateOption {
    color: #E7ECF3;
    font-weight: 650;
}

#fieldLabel {
    color: #AAB5C5;
    font-size: 11px;
    font-weight: 650;
}

#dialogError {
    color: #FF7D8A;
    font-size: 11px;
}

QPushButton[secondary="true"] {
    background-color: #171E29;
    border-color: #344156;
}

QPushButton[secondary="true"]:hover {
    background-color: #222C3C;
    border-color: #4A5870;
}

#projectSettingsDialog,
#exportDialog {
    background-color: #0D1117;
}

#dialogHero {
    background-color: #141A23;
    border: 1px solid #293445;
    border-radius: 5px;
    padding: 6px;
}

#dialogHeroIcon {
    background-color: #15253A;
    border: 1px solid #2F527D;
    border-radius: 4px;
    padding: 6px;
}

#dialogHeroTitle {
    color: #F3F6FA;
    font-size: 17px;
    font-weight: 750;
}

#dialogHeroSubtitle,
#exportSummary {
    color: #7F8B9D;
}

#exportSummary {
    background-color: #121923;
    border: 1px solid #273141;
    border-radius: 4px;
    padding: 6px;
}

#exportLog {
    background-color: #090D12;
    border-color: #263142;
    color: #9CE2AF;
    font-family: "Menlo";
    font-size: 10px;
}

#commandPaletteDialog,
#globalSearchDialog {
    background-color: #111720;
    border: 1px solid #46536A;
    border-radius: 5px;
}

#commandPaletteSearch,
#globalSearchField {
    background-color: #0D1218;
    border: 1px solid #3A465A;
    border-radius: 4px;
    padding: 7px 9px;
    font-size: 14px;
}

#commandPaletteSearch:focus,
#globalSearchField:focus {
    border-color: #6BA3FF;
}

#commandPaletteList,
#globalSearchResults {
    background-color: #111720;
    border: none;
    padding: 5px;
}

#commandPaletteList::item,
#globalSearchResults::item {
    min-height: 30px;
    padding: 6px 8px;
}
