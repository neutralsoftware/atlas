* {
    font-family: "Manrope", "SF Pro Text", "Segoe UI", "Arial";
    font-size: 13px;
    color: #E6EDF7;
    selection-background-color: #364357;
    selection-color: #ECF4FF;
}

QWidget {
    background: #1B2230;
}

QMainWindow,
QDialog,
#editorFrame,
#projectBrowserRoot {
    background: #10141D;
}

QLabel,
QCheckBox,
QRadioButton,
QToolButton,
QPushButton {
    background: transparent;
}

QLabel:disabled {
    color: #65758C;
}

QLabel[muted="true"] {
    color: #A5B2C7;
}

QPushButton,
QToolButton {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #303C50, stop:1 #202A3B);
    border: 1px solid #46556D;
    border-top-color: #65758F;
    border-bottom-color: #172131;
    border-radius: 10px;
    padding: 5px 10px;
    min-height: 24px;
}

QPushButton:hover,
QToolButton:hover {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #3C4A60, stop:1 #263347);
    border-top-color: #8A9BB5;
}

QPushButton:checked,
QToolButton:checked {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #47678E, stop:1 #2C4260);
    border-color: #587BA6;
    color: #F3F8FF;
}

QPushButton:disabled,
QToolButton:disabled {
    color: #748198;
    background: #222B39;
    border-color: #303B4E;
}

QPushButton:pressed,
QToolButton:pressed {
    background: #1B2A3E;
    border-color: #46556D;
}

QPushButton:focus,
QToolButton:focus {
    border-color: #9ACBFF;
}

QToolButton::menu-indicator {
    image: none;
}

QLineEdit,
QTextEdit,
QPlainTextEdit {
    background: #202938;
    border: 1px solid #354257;
    border-radius: 8px;
    padding: 7px 9px;
    selection-background-color: #354E70;
}

QLineEdit:hover,
QTextEdit:hover,
QPlainTextEdit:hover {
    background: #242E3E;
}

QLineEdit:focus,
QTextEdit:focus,
QPlainTextEdit:focus {
    border-color: #9ACBFF;
}

QLineEdit:disabled,
QTextEdit:disabled,
QPlainTextEdit:disabled {
    color: #748198;
}

QComboBox,
QSpinBox,
QDoubleSpinBox,
QDateEdit,
QTimeEdit,
QDateTimeEdit {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #293549, stop:1 #222C3D);
    border: 1px solid #3D4C63;
    border-radius: 8px;
    min-height: 24px;
    padding: 3px 8px;
    color: #E6EDF7;
}

QComboBox:hover,
QSpinBox:hover,
QDoubleSpinBox:hover {
    background: #2B3648;
}

QComboBox:focus,
QSpinBox:focus,
QDoubleSpinBox:focus {
    border-color: #9ACBFF;
}

QComboBox:disabled,
QSpinBox:disabled,
QDoubleSpinBox:disabled {
    color: #748198;
}

QComboBox {
    padding-right: 28px;
}

QComboBox::drop-down {
    width: 26px;
    border: none;
}

QComboBox::down-arrow,
QAbstractSpinBox::down-arrow {
    image: url(:/editor/assets/chevron-down.svg);
    width: 12px;
    height: 12px;
}

QAbstractSpinBox::up-arrow {
    image: url(:/editor/assets/chevron-up.svg);
    width: 12px;
    height: 12px;
}

QAbstractSpinBox::up-button,
QAbstractSpinBox::down-button {
    background: transparent;
    border: none;
    width: 18px;
}

QComboBox QAbstractItemView {
    background: #222B3C;
    border: 1px solid #3A485D;
    border-radius: 8px;
    padding: 5px;
}

QCheckBox,
QRadioButton {
    spacing: 9px;
}

QCheckBox::indicator {
    width: 16px;
    height: 16px;
    border: 1px solid #54657D;
    border-radius: 4px;
    background: #232C3D;
}

QCheckBox::indicator:hover {
    border-color: #A9B6CA;
}

QCheckBox::indicator:checked {
    image: url(:/editor/assets/check.svg);
    background: #7B8AA0;
    border-color: #A9B6CA;
}

QCheckBox::indicator:indeterminate {
    background: #A9B6CA;
    border: 4px solid #445369;
}

QRadioButton::indicator {
    width: 16px;
    height: 16px;
    background: #232C3D;
    border: 1px solid #54657D;
    border-radius: 9px;
}

QRadioButton::indicator:checked {
    width: 8px;
    height: 8px;
    background: #DAE7F9;
    border: 5px solid #54657D;
    border-radius: 9px;
}

QSlider::groove:horizontal {
    height: 3px;
    background: #354256;
    border-radius: 1px;
}

QSlider::sub-page:horizontal {
    background: #A2B0C5;
    border-radius: 1px;
}

QSlider::handle:horizontal {
    background: #D6E3F4;
    border: none;
    width: 10px;
    margin: -4px 0;
    border-radius: 5px;
}

QProgressBar {
    background: #293345;
    border: none;
    border-radius: 3px;
    min-height: 6px;
    text-align: center;
    color: #ECF4FF;
}

QProgressBar::chunk {
    background: #7D8CA2;
    border-radius: 3px;
}

QScrollArea,
QAbstractScrollArea {
    background: #1B2230;
    border: none;
}

QAbstractScrollArea::corner {
    background: transparent;
}

QScrollBar:vertical {
    background: transparent;
    border: none;
    width: 8px;
    margin: 3px 1px;
}

QScrollBar:horizontal {
    background: transparent;
    border: none;
    height: 8px;
    margin: 1px 3px;
}

QScrollBar::handle:vertical,
QScrollBar::handle:horizontal {
    background: #3B495F;
    border-radius: 3px;
    min-height: 32px;
    min-width: 32px;
}

QScrollBar::handle:vertical:hover,
QScrollBar::handle:horizontal:hover {
    background: #617289;
}

QScrollBar::add-line,
QScrollBar::sub-line,
QScrollBar::add-page,
QScrollBar::sub-page {
    border: none;
    background: transparent;
    width: 0;
    height: 0;
}

QTreeView,
QListView,
QTableView {
    background: #1B2230;
    border: none;
    outline: none;
    alternate-background-color: #1E2635;
    show-decoration-selected: 1;
}

QTreeView::item,
QListView::item,
QTableView::item {
    border: none;
    padding: 5px 8px;
}

QTreeView::item:selected,
QListView::item:selected,
QTableView::item:selected {
    background: #354E70;
    color: #ECF4FF;
}

QHeaderView::section {
    background: #1B2230;
    border: none;
    border-bottom: 1px solid #2B3648;
    color: #A5B2C7;
    padding: 9px;
    font-weight: 400;
}

QGroupBox {
    background: transparent;
    border: none;
    border-top: 1px solid #2B3648;
    margin-top: 26px;
    padding: 14px 2px 6px 2px;
    font-weight: 500;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    padding: 0;
    color: #DAE8F9;
}

QTabWidget::pane {
    background: #1B2230;
    border: none;
}

QTabBar {
    background: transparent;
}

QTabBar::tab {
    background: transparent;
    border: none;
    color: #A5B2C7;
    padding: 9px 16px;
    margin: 4px 3px;
    border-radius: 6px;
}

QTabBar::tab:selected {
    background: #2B3648;
    color: #E2EFFF;
}

QTabBar::tab:hover {
    color: #E2EFFF;
}

QMenuBar {
    background: #10141D;
    border: none;
    padding: 3px 10px;
}

QMenuBar::item {
    background: transparent;
    padding: 5px 9px;
}

QMenuBar::item:selected {
    background: #2B3648;
    border-radius: 5px;
}

QMenu {
    background: #202938;
    border: 1px solid #3A485D;
    border-radius: 8px;
    padding: 6px;
}

QMenu::item {
    background: transparent;
    padding: 9px 34px 9px 12px;
    border-radius: 5px;
}

QMenu::item:selected {
    background: #334054;
}

QMenu::item:disabled {
    color: #748198;
}

QMenu::separator {
    background: #354256;
    height: 1px;
    margin: 6px 10px;
}

QToolTip {
    background: #293345;
    color: #DCEAFB;
    border: 1px solid #445369;
    border-radius: 5px;
    padding: 6px 9px;
}

QSplitter::handle {
    background: #10141D;
}

QSplitter::handle:hover {
    background: #415066;
}

QStatusBar {
    background: #10141D;
    color: #95A3B9;
    border: none;
    padding: 3px 14px;
    min-height: 24px;
    font-size: 11px;
}

QStatusBar::item {
    border: none;
}

#workspaceBar,
#workspaceChrome,
#workspaceIdentity,
#workspaceIdentityText,
#workspaceActivity,
#workspaceUtilities {
    background: #10141D;
    border: none;
}

#workspaceBar {
    padding: 0;
    spacing: 0;
}

#workspaceProject {
    color: #D7E4F6;
    font-size: 13px;
}

#workspaceSwitcher,
#workspaceSurface,
#workspaceHeading,
#editorWorkspaceStack {
    background: #1B2230;
    border: none;
}

#workspaceHeading {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #293447, stop:1 #1B2230);
    border-top: 1px solid #46556D;
    border-top-left-radius: 14px;
    border-top-right-radius: 14px;
}

#workspaceSwitcher {
    background: #141C29;
    border: 1px solid #3D4C63;
    border-radius: 12px;
    padding: 0;
}

#workspaceMark {
    background: transparent;
    border: none;
}

#workspaceContextPath,
#statusVersion,
#statusRenderer,
#statusRuntimeText,
#viewportFpsLabel,
#viewportShortcutHint {
    background: transparent;
    color: #96A4BA;
    font-size: 11px;
    border: none;
}

#statusRuntime {
    background: transparent;
}

#sceneTabs {
    background: #1B2230;
    border: none;
}

#sceneTabs::tab {
    padding: 9px 14px;
    min-width: 92px;
}

#viewportTools {
    background: #1B2230;
}

#viewportToolbar,
#panelToolbar,
#materialEditorHeader,
#postProcessingToolbar,
#workspaceToolbar {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #2C384C, stop:1 #202938);
    border: 1px solid #46556D;
    border-bottom-color: #141C29;
    border-radius: 12px;
}

#hierarchySearch,
#contentSearchField {
    background: #222B3C;
    padding: 6px 9px;
}

#contentPathField {
    background: transparent;
    border: none;
    color: #B4C1D5;
}

#inspectorScroll,
#inspectorContent,
#materialEditorBody,
#postProcessingBody,
#environmentPages,
#environmentWorkspace,
#environmentPage {
    background: #1B2230;
    border: none;
}

#inspectorHeader {
    background: transparent;
    border: none;
    padding: 0;
}

#inspectorObjectIcon {
    background: transparent;
    border: none;
}

#inspectorNameField {
    background: transparent;
    border: 1px solid transparent;
    color: #E2EFFF;
    font-size: 18px;
    font-weight: 500;
    padding: 2px 0;
}

#inspectorNameField:focus {
    border-color: #54657D;
}

#inspectorTypeLabel,
#inspectorPropertyLabel,
#materialTexturePath,
#materialEditorStatus,
#postProcessingStatus,
#workspaceStatus,
#workspaceAutoApply {
    color: #A3B0C5;
    font-size: 12px;
}

#inspectorComponent {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #252F40, stop:1 #1D2635);
    border: 1px solid #354257;
    border-top-color: #46556D;
    border-radius: 12px;
}

#inspectorComponentHeaderRow,
#inspectorComponentBody,
#inspectorPropertyRow,
#inspectorNestedGroup,
#inspectorAudioControls {
    background: transparent;
    border: none;
}

#inspectorVectorField,
#inspectorNumericField,
#inspectorColorField {
    background: #252F40;
    border: none;
    border-radius: 5px;
}

#inspectorVectorField QDoubleSpinBox,
#inspectorNumericField QDoubleSpinBox {
    background: transparent;
    border: none;
    padding: 4px 2px;
}

#inspectorAxisX,
#inspectorAxisY,
#inspectorAxisZ {
    background: transparent;
    font-size: 10px;
    padding: 0 3px;
}

#inspectorAxisX { color: #CA9290; }
#inspectorAxisY { color: #9AB696; }
#inspectorAxisZ { color: #91A9C7; }

#inspectorColorSwatch {
    border: 1px solid #45546A;
    border-radius: 4px;
    padding: 2px;
}

#inspectorColorText {
    color: #BCC9DB;
    font-family: "SF Mono", "Menlo", "Consolas";
    font-size: 11px;
}

#inspectorNestedTitle,
#inspectorArrayTitle,
#materialTextureLabel {
    color: #D0DDEE;
    font-weight: 500;
}

#inspectorEmptyTitle,
#materialEditorEmpty,
#postProcessingEmpty {
    color: #CEDBED;
    font-size: 15px;
    font-weight: 400;
}

#inspectorEmptyHint,
#environmentPageSubtitle,
#dialogHeroSubtitle {
    color: #A5B2C7;
}

#materialEditorTitle,
#postProcessingTitle,
#postProcessingSectionTitle,
#workspaceTitle,
#inspectorCameraTitle {
    color: #D8E5F7;
    font-size: 13px;
    font-weight: 500;
}

#materialPreview {
    background: #141924;
    border: none;
    border-radius: 8px;
}

#materialTextureSlot {
    background: transparent;
    border: none;
    padding: 6px 0;
}

#materialTexturePreview {
    background: #242E3E;
    border: none;
    border-radius: 6px;
}

#environmentCategories {
    background: #1B2230;
    border: none;
    padding: 8px;
}

#environmentPageTitle {
    color: #DFEDFF;
    font-size: 22px;
    font-weight: 500;
}

ads--CDockContainerWidget,
ads--CDockContainerWidget > QSplitter,
ads--CDockContainerWidget ads--CDockSplitter::handle {
    background: #10141D;
}

ads--CDockAreaWidget,
ads--CDockAreaWidget[focused="true"] {
    background: #1B2230;
    border: 1px solid #354257;
    border-radius: 14px;
}

ads--CDockAreaTitleBar,
ads--CDockAreaWidget[focused="true"] ads--CDockAreaTitleBar {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #303C50, stop:1 #202938);
    border: none;
    border-top: 1px solid #52637A;
    border-top-left-radius: 14px;
    border-top-right-radius: 14px;
    min-height: 40px;
}

#tabsContainerWidget {
    background: transparent;
}

ads--CDockWidgetTab,
ads--CDockWidgetTab[activeTab="true"],
ads--CDockWidgetTab[focused="true"] {
    background: transparent;
    border: none;
    padding: 3px 10px;
    margin: 3px;
}

ads--CDockWidgetTab #dockWidgetTabLabel {
    color: #AFBCD0;
    font-size: 13px;
    padding: 4px 0;
}

ads--CDockWidgetTab[activeTab="true"] #dockWidgetTabLabel {
    color: #D8E6F8;
}

ads--CTitleBarButton,
#tabCloseButton,
#dockAreaCloseButton,
#detachGroupButton,
#dockAreaAutoHideButton,
#dockAreaMinimizeButton,
#tabsMenuButton {
    background: transparent;
    border: none;
    padding: 4px;
    min-width: 18px;
    min-height: 18px;
}

ads--CTitleBarButton:hover,
#tabCloseButton:hover {
    background: #2B3648;
    border-radius: 5px;
}

ads--CDockWidget {
    background: #1B2230;
}

ads--CAutoHideSideBar,
#sideTabsContainerWidget {
    background: #10141D;
}

ads--CAutoHideTab {
    background: transparent;
    border: none;
    padding: 7px;
}

#projectSidebar {
    background: #10141D;
    border: none;
}

#projectBrowserContent {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1, stop:0 #283346, stop:0.45 #1B2230, stop:1 #1D293B);
    border: 1px solid #46556D;
    border-radius: 16px;
}

#projectBrand {
    color: #DFEDFF;
    font-size: 16px;
    font-weight: 500;
}

#projectSidebarVersion,
#projectSidebarCaption,
#projectPath,
#projectDate,
#projectBrowserSubtitle,
#dialogSubtitle,
#emptyStateSubtitle,
#templateDescription {
    color: #A5B2C7;
    font-size: 12px;
}

#projectBrowserTitle,
#dialogTitle {
    color: #E3EFFF;
    font-size: 28px;
    font-weight: 500;
}

#projectSearch {
    background: #222B3C;
    padding: 10px 12px;
}

#projectList {
    background: transparent;
    border: none;
}

#projectRow {
    background: #202938;
    border: 1px solid #354257;
    border-radius: 12px;
}

#projectRow:hover {
    background: #242E3E;
}

#projectRow[selected="true"] {
    background: #354E70;
}

#projectName {
    color: #DAE8FA;
    font-size: 14px;
    font-weight: 400;
}

#projectIcon,
#templateIcon {
    background: transparent;
    border: none;
}

#rendererBadge {
    background: #252F41;
    border: none;
    border-radius: 4px;
    color: #B7C4D7;
    font-size: 10px;
    padding: 4px 7px;
}

#projectEmptyState {
    background: transparent;
    border: none;
}

#emptyStateTitle {
    color: #D3E0F1;
    font-size: 20px;
    font-weight: 400;
}

QFrame[templateCard="true"] {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #2C384C, stop:1 #202938);
    border: 1px solid #46556D;
    border-radius: 12px;
}

QFrame[templateCard="true"][selected="true"] {
    background: #354E70;
    border-color: #9ACBFF;
}

#templateOption,
#fieldLabel {
    color: #C6D3E5;
    font-weight: 400;
}

#dialogError {
    color: #D69C95;
    font-size: 12px;
}

#dialogHero {
    background: transparent;
    border: none;
    padding: 2px;
}

#dialogHeroIcon {
    background: transparent;
    border: none;
    padding: 4px;
}

#dialogHeroTitle {
    color: #DDEBFC;
    font-size: 22px;
    font-weight: 500;
}

#exportSummary {
    background: #1E2635;
    border: none;
    border-radius: 6px;
    color: #ABB8CC;
    padding: 12px;
}

#exportLog,
#runtimeErrors {
    background: #161B27;
    border: none;
    padding: 12px;
    font-family: "SF Mono", "Menlo", "Consolas";
    font-size: 12px;
    color: #C6D3E5;
}

#commandPaletteDialog,
#globalSearchDialog {
    background: #1B2230;
    border: 1px solid #38455A;
    border-radius: 10px;
}

#commandPaletteSearch,
#globalSearchField {
    background: transparent;
    border: none;
    border-bottom: 1px solid #303C4F;
    border-radius: 0;
    padding: 15px 12px;
    font-size: 16px;
}

#commandPaletteList,
#globalSearchResults {
    background: transparent;
    padding: 4px;
}

#paletteHint,
#projectListHint {
    background: transparent;
    color: #8897AD;
    font-size: 11px;
    padding: 7px 12px;
}

#splashCard {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1, stop:0 #35455F, stop:0.5 #1B2230, stop:1 #25344B);
    border: 1px solid #65758F;
    border-radius: 16px;
}

#atlasSplash,
#splashIcon {
    background: transparent;
}

#splashTitle {
    color: #E5F0FF;
    font-size: 36px;
    font-weight: 500;
}

#splashVersion,
#splashCompany,
#splashWarning {
    color: #A1AEC3;
    font-size: 12px;
}

#splashStatus {
    color: #C8D5E7;
    font-size: 12px;
}

#splashProgress {
    background: #2B3749;
    border: none;
    min-height: 0;
    border-radius: 2px;
}

#splashProgress::chunk {
    background: #C5D2E4;
    border-radius: 2px;
}

QPushButton:default {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #F3F8FF, stop:1 #C5D9F2);
    color: #1B2230;
}

#projectSectionLabel {
    color: #8D9BB1;
    font-size: 12px;
    padding: 3px 10px;
}

#searchPreviewPane {
    background: #171D2A;
    border: none;
    border-left: 1px solid #303C4F;
}

#searchPreviewText {
    background: transparent;
    border: none;
    padding: 0;
    font-family: "SF Mono", "Menlo", "Consolas";
    font-size: 12px;
    color: #C1CEE0;
}

#projectRow[available="false"] #projectName {
    color: #8D9BB1;
}

QAbstractSpinBox QLineEdit {
    background: transparent;
    border: none;
    padding: 0;
    min-height: 0;
}

#inspectorVectorField {
    background: transparent;
    border: none;
}

#inspectorAxisField {
    background: #252F40;
    border: 1px solid transparent;
    border-radius: 6px;
}

#inspectorAxisField:hover {
    background: #2C3749;
    border-color: #445369;
}

#inspectorAxisField QDoubleSpinBox {
    background: transparent;
    border: none;
    padding: 5px 2px;
    min-height: 24px;
}

#inspectorNumberField,
#inspectorNameField,
#inspectorColorText {
    min-height: 26px;
}

#inspectorAxisX,
#inspectorAxisY,
#inspectorAxisZ {
    padding: 0;
    font-size: 11px;
}

QTabBar::close-button {
    image: url(:/editor/assets/close.svg);
    width: 14px;
    height: 14px;
    padding: 5px;
    border-radius: 5px;
}

QTabBar::close-button:hover,
#tabCloseButton:hover,
#dockAreaCloseButton:hover {
    background: #354256;
}

QPushButton:default:hover {
    background: #F3F8FF;
}

QPushButton:default:pressed {
    background: #B4CBE7;
}

QPushButton:default:disabled {
    background: #222B39;
    color: #748198;
}

ads--CDockWidgetTab[activeTab="true"] {
    background: #354E70;
    border-radius: 8px;
}

QCheckBox:focus,
QRadioButton:focus {
