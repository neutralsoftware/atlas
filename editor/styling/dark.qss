* {
    font-family: "Geist", "SF Pro Text", "Segoe UI", "Arial";
    font-size: 13px;
    color: #EDEDED;
    selection-background-color: #262626;
    selection-color: #EDEDED;
}

QWidget {
    background: #0A0A0A;
}

QMainWindow,
QDialog,
#editorFrame,
#projectBrowserRoot {
    background: #0A0A0A;
}

QLabel,
QCheckBox,
QRadioButton,
QToolButton,
QPushButton {
    background: transparent;
}

QLabel:disabled {
    color: #707070;
}

QLabel[muted="true"] {
    color: #A1A1A1;
}

QPushButton,
QToolButton {
    background: #0A0A0A;
    border: 1px solid #2E2E2E;
    border-radius: 6px;
    padding: 5px 10px;
    min-height: 24px;
}

QPushButton:enabled:hover,
QToolButton:enabled:hover {
    background: #202020;
    border-color: #525252;
}

QPushButton:checked,
QToolButton:checked {
    background: #292929;
    border-color: #525252;
    color: #EDEDED;
}

QPushButton:disabled,
QToolButton:disabled {
    color: #707070;
    background: #141414;
    border-color: #2E2E2E;
}

QPushButton:enabled:pressed,
QToolButton:enabled:pressed {
    background: #141414;
    border-color: #2E2E2E;
}

QPushButton:focus,
QToolButton:focus {
    border-color: #52A8FF;
}

QToolButton::menu-indicator {
    image: none;
}

QLineEdit,
QTextEdit,
QPlainTextEdit {
    background: #141414;
    border: 1px solid #2E2E2E;
    border-radius: 6px;
    padding: 7px 9px;
    selection-background-color: #262626;
}

QLineEdit:hover,
QTextEdit:hover,
QPlainTextEdit:hover {
    background: #141414;
}

QLineEdit:focus,
QTextEdit:focus,
QPlainTextEdit:focus {
    border-color: #52A8FF;
}

QLineEdit:disabled,
QTextEdit:disabled,
QPlainTextEdit:disabled {
    color: #707070;
}

QComboBox,
QSpinBox,
QDoubleSpinBox,
QDateEdit,
QTimeEdit,
QDateTimeEdit {
    background: #141414;
    border: 1px solid #2E2E2E;
    border-radius: 6px;
    min-height: 24px;
    padding: 3px 8px;
    color: #EDEDED;
}

QComboBox:hover,
QSpinBox:hover,
QDoubleSpinBox:hover {
    background: #141414;
}

QComboBox:focus,
QSpinBox:focus,
QDoubleSpinBox:focus {
    border-color: #52A8FF;
}

QComboBox:disabled,
QSpinBox:disabled,
QDoubleSpinBox:disabled {
    color: #707070;
}

QComboBox {
    padding-right: 28px;
}

QComboBox::drop-down {
    width: 26px;
    border: none;
}

QComboBox::down-arrow,
QAbstractSpinBox::down-arrow {
    image: url(:/editor/assets/chevron-down.svg);
    width: 12px;
    height: 12px;
}

QAbstractSpinBox::up-arrow {
    image: url(:/editor/assets/chevron-up.svg);
    width: 12px;
    height: 12px;
}

QAbstractSpinBox::up-button,
QAbstractSpinBox::down-button {
    background: transparent;
    border: none;
    width: 18px;
}

QComboBox QAbstractItemView {
    background: #141414;
    border: 1px solid #2E2E2E;
    border-radius: 6px;
    padding: 5px;
}

QCheckBox,
QRadioButton {
    spacing: 9px;
}

QCheckBox::indicator {
    width: 16px;
    height: 16px;
    border: 1px solid #2E2E2E;
    border-radius: 4px;
    background: #141414;
}

QCheckBox::indicator:hover {
    border-color: #525252;
}

QCheckBox::indicator:checked {
    image: url(:/editor/assets/check.svg);
    background: #A1A1A1;
    border-color: #525252;
}

QCheckBox::indicator:indeterminate {
    background: #A1A1A1;
    border: 4px solid #2E2E2E;
}

QRadioButton::indicator {
    width: 16px;
    height: 16px;
    background: #141414;
    border: 1px solid #2E2E2E;
    border-radius: 6px;
}

QRadioButton::indicator:checked {
    width: 8px;
    height: 8px;
    background: #EDEDED;
    border: 5px solid #2E2E2E;
    border-radius: 6px;
}

QSlider::groove:horizontal {
    height: 3px;
    background: #262626;
    border-radius: 1px;
}

QSlider::sub-page:horizontal {
    background: #A1A1A1;
    border-radius: 1px;
}

QSlider::handle:horizontal {
    background: #EDEDED;
    border: none;
    width: 10px;
    margin: -4px 0;
    border-radius: 5px;
}

QProgressBar {
    background: #141414;
    border: none;
    border-radius: 3px;
    min-height: 6px;
    text-align: center;
    color: #EDEDED;
}

QProgressBar::chunk {
    background: #A1A1A1;
    border-radius: 3px;
}

QScrollArea,
QAbstractScrollArea {
    background: #0A0A0A;
    border: none;
}

QAbstractScrollArea::corner {
    background: transparent;
}

QScrollBar:vertical {
    background: transparent;
    border: none;
    width: 8px;
    margin: 3px 1px;
}

QScrollBar:horizontal {
    background: transparent;
    border: none;
    height: 8px;
    margin: 1px 3px;
}

QScrollBar::handle:vertical,
QScrollBar::handle:horizontal {
    background: #262626;
    border-radius: 3px;
    min-height: 32px;
    min-width: 32px;
}

QScrollBar::handle:vertical:hover,
QScrollBar::handle:horizontal:hover {
    background: #A1A1A1;
}

QScrollBar::add-line,
QScrollBar::sub-line,
QScrollBar::add-page,
QScrollBar::sub-page {
    border: none;
    background: transparent;
    width: 0;
    height: 0;
}

QTreeView,
QListView,
QTableView {
    background: #0A0A0A;
    border: none;
    outline: none;
    alternate-background-color: #141414;
    show-decoration-selected: 1;
}

QTreeView::item,
QListView::item,
QTableView::item {
    border: none;
    padding: 5px 8px;
}

QTreeView::item:selected,
QListView::item:selected,
QTableView::item:selected {
    background: #262626;
    color: #EDEDED;
}

QHeaderView::section {
    background: #141414;
    border: none;
    border-bottom: 1px solid #2E2E2E;
    color: #A1A1A1;
    padding: 9px;
    font-weight: 400;
}

QGroupBox {
    background: transparent;
    border: none;
    border-top: 1px solid #2E2E2E;
    margin-top: 26px;
    padding: 14px 2px 6px 2px;
    font-weight: 500;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    padding: 0;
    color: #EDEDED;
}

QTabWidget::pane {
    background: #141414;
    border: none;
}

QTabBar {
    background: transparent;
}

QTabBar::tab {
    background: transparent;
    border: none;
    color: #A1A1A1;
    padding: 9px 16px;
    margin: 4px 3px;
    border-radius: 6px;
}

QTabBar::tab:selected {
    background: #141414;
    color: #EDEDED;
}

QTabBar::tab:hover {
    color: #EDEDED;
}

QMenuBar {
    background: #0A0A0A;
    border: none;
    padding: 3px 10px;
}

QMenuBar::item {
    background: transparent;
    padding: 5px 9px;
}

QMenuBar::item:selected {
    background: #141414;
    border-radius: 5px;
}

QMenu {
    background: #141414;
    border: 1px solid #2E2E2E;
    border-radius: 6px;
    padding: 6px;
}

QMenu::item {
    background: transparent;
    padding: 9px 34px 9px 12px;
    border-radius: 5px;
}

QMenu::item:selected {
    background: #262626;
}

QMenu::item:disabled {
    color: #707070;
}

QMenu::separator {
    background: #262626;
    height: 1px;
    margin: 6px 10px;
}

QToolTip {
    background: #141414;
    color: #EDEDED;
    border: 1px solid #2E2E2E;
    border-radius: 5px;
    padding: 6px 9px;
}

QSplitter::handle {
    background: #0A0A0A;
}

QSplitter::handle:hover {
    background: #262626;
}

QStatusBar {
    background: #0A0A0A;
    color: #A1A1A1;
    border: none;
    padding: 3px 14px;
    min-height: 24px;
    font-size: 11px;
}

QStatusBar::item {
    border: none;
}

#workspaceBar,
#workspaceChrome,
#workspaceIdentity,
#workspaceIdentityText,
#workspaceActivity,
#workspaceUtilities {
    background: #0A0A0A;
    border: none;
}

#workspaceBar {
    padding: 0;
    spacing: 0;
}

#workspaceProject {
    color: #EDEDED;
    font-size: 13px;
}

#workspaceSurface,
#workspaceHeading,
#editorWorkspaceStack {
    background: #0A0A0A;
    border: none;
}

#workspaceHeading {
    background: #0A0A0A;
    border: none;
    border-bottom: 1px solid #292929;
}

#workspaceNavigation {
    background: #0A0A0A;
    border: none;
    border-bottom: 1px solid #292929;
}

#workspaceContextTitle,
#panelHeadingTitle {
    color: #EDEDED;
    font-size: 14px;
    font-weight: 600;
}

#workspaceContextIcon,
#workspaceContextTitle,
#panelHeading,
#contentActions,
#inspectorIdentity {
    background: transparent;
}

#inspectorEyebrow {
    background: transparent;
    color: #A1A1A1;
    font-size: 10px;
    font-weight: 600;
}

#workspaceMark {
    background: transparent;
    border: none;
}

#workspaceContextPath,
#statusVersion,
#statusRenderer,
#statusRuntimeText,
#viewportFpsLabel,
#viewportShortcutHint {
    background: transparent;
    color: #A1A1A1;
    font-size: 11px;
    border: none;
}

#statusRuntime {
    background: transparent;
}

#sceneTabs {
    background: #141414;
    border: none;
}

#sceneTabs::tab {
    padding: 9px 14px;
    min-width: 92px;
}

#viewportTools {
    background: #141414;
}

#viewportToolbar,
#panelToolbar,
#materialEditorHeader,
#postProcessingToolbar,
#workspaceToolbar {
    background: #0A0A0A;
    border: none;
    border-bottom: 1px solid #292929;
}

#hierarchySearch,
#contentSearchField {
    background: #141414;
    padding: 6px 9px;
}

#contentPathField {
    background: transparent;
    border: none;
    color: #A1A1A1;
}

#inspectorScroll,
#inspectorContent,
#materialEditorBody,
#postProcessingBody,
#environmentPages,
#environmentWorkspace,
#environmentPage {
    background: #0A0A0A;
    border: none;
}

#inspectorHeader {
    background: transparent;
    border: none;
    border-bottom: 1px solid #292929;
    padding: 0;
}

#inspectorObjectIcon {
    background: transparent;
    border: none;
}

#inspectorNameField {
    background: transparent;
    border: 1px solid transparent;
    color: #EDEDED;
    font-size: 18px;
    font-weight: 500;
    padding: 2px 0;
}

#inspectorNameField:focus {
    border-color: #52A8FF;
}

#inspectorTypeLabel,
#inspectorPropertyLabel,
#materialTexturePath,
#materialEditorStatus,
#postProcessingStatus,
#workspaceStatus,
#workspaceAutoApply {
    color: #A1A1A1;
    font-size: 12px;
}

#inspectorComponent {
    background: #101010;
    border: 1px solid #292929;
    border-radius: 6px;
}

#inspectorComponentHeader {
    background: transparent;
    border: none;
    color: #EDEDED;
    text-align: left;
    font-size: 13px;
    font-weight: 600;
    padding: 6px 8px;
}

#inspectorComponentHeader:hover {
    background: #202020;
}

#inspectorComponentHeader:focus {
    border: 1px solid #52A8FF;
    padding: 5px 7px;
}

#inspectorPropertyLabel {
    color: #D4D4D4;
    font-size: 12px;
    padding: 0;
}

#inspectorPanel QLineEdit,
#inspectorPanel QAbstractSpinBox,
#inspectorPanel QComboBox,
#inspectorPanel QPlainTextEdit {
    color: #EDEDED;
    selection-background-color: #35465C;
    selection-color: #FFFFFF;
}

#inspectorPanel QLineEdit:disabled,
#inspectorPanel QAbstractSpinBox:disabled,
#inspectorPanel QComboBox:disabled {
    color: #8A8A8A;
}

#inspectorComponentHeaderRow,
#inspectorComponentBody,
#inspectorPropertyRow,
#inspectorNestedGroup,
#inspectorAudioControls {
    background: transparent;
    border: none;
}

#inspectorVectorField,
#inspectorNumericField,
#inspectorColorField {
    background: #141414;
    border: none;
    border-radius: 5px;
}

#inspectorVectorField QDoubleSpinBox,
#inspectorNumericField QDoubleSpinBox {
    background: transparent;
    border: none;
    padding: 4px 2px;
}

#inspectorAxisX,
#inspectorAxisY,
#inspectorAxisZ {
    background: transparent;
}

#inspectorAxisX {
    color: #E59292;
}
#inspectorAxisY {
    color: #8ECDA0;
}
#inspectorAxisZ { color: #84B5EB; }

#inspectorColorSwatch {
    border: 1px solid #2E2E2E;
    border-radius: 4px;
    padding: 2px;
}

#inspectorColorText {
    color: #A1A1A1;
    font-family: "SF Mono", "Menlo", "Consolas";
    font-size: 11px;
}

#inspectorNestedTitle,
#inspectorArrayTitle,
#materialTextureLabel {
    color: #EDEDED;
    font-weight: 500;
}

#inspectorEmptyTitle,
#materialEditorEmpty,
#postProcessingEmpty {
    color: #EDEDED;
    font-size: 15px;
    font-weight: 400;
}

#inspectorEmptyHint,
#environmentPageSubtitle,
#dialogHeroSubtitle {
    color: #A1A1A1;
}

#materialEditorTitle,
#postProcessingTitle,
#postProcessingSectionTitle,
#workspaceTitle,
#inspectorCameraTitle {
    color: #EDEDED;
    font-size: 13px;
    font-weight: 500;
}

#materialPreview {
    background: #0A0A0A;
    border: none;
    border-radius: 6px;
}

#materialTextureSlot {
    background: transparent;
    border: none;
    padding: 6px 0;
}

#materialTexturePreview {
    background: #141414;
    border: none;
    border-radius: 6px;
}

#environmentCategories {
    background: #141414;
    border: none;
    padding: 8px;
}

#environmentPageTitle {
    color: #EDEDED;
    font-size: 22px;
    font-weight: 500;
}

ads--CDockContainerWidget,
ads--CDockContainerWidget > QSplitter,
ads--CDockContainerWidget ads--CDockSplitter::handle {
    background: #0A0A0A;
}

ads--CDockAreaWidget,
ads--CDockAreaWidget[focused="true"] {
    background: #0A0A0A;
    border: none;
    border-radius: 0;
}

ads--CDockAreaTitleBar,
ads--CDockAreaWidget[focused="true"] ads--CDockAreaTitleBar {
    background: #0A0A0A;
    border: none;
    border-bottom: 1px solid #292929;
    min-height: 36px;
}

#tabsContainerWidget {
    background: transparent;
}

ads--CDockWidgetTab,
ads--CDockWidgetTab[activeTab="true"],
ads--CDockWidgetTab[focused="true"] {
    background: transparent;
    border: none;
    padding: 3px 10px;
    margin: 3px;
}

ads--CDockWidgetTab #dockWidgetTabLabel {
    color: #A1A1A1;
    font-size: 13px;
    padding: 4px 0;
}

ads--CDockWidgetTab[activeTab="true"] #dockWidgetTabLabel {
    color: #EDEDED;
}

ads--CTitleBarButton,
#tabCloseButton,
#dockAreaCloseButton,
#detachGroupButton,
#dockAreaAutoHideButton,
#dockAreaMinimizeButton,
#tabsMenuButton {
    background: transparent;
    border: none;
    padding: 4px;
    min-width: 18px;
    min-height: 18px;
}

ads--CTitleBarButton:hover,
#tabCloseButton:hover {
    background: #141414;
    border-radius: 5px;
}

ads--CDockWidget {
    background: #0A0A0A;
}

ads--CAutoHideSideBar,
#sideTabsContainerWidget {
    background: #0A0A0A;
}

ads--CAutoHideTab {
    background: transparent;
    border: none;
    padding: 7px;
}

#projectSidebar {
    background: #0A0A0A;
    border: none;
}

#projectBrowserContent {
    background: #0A0A0A;
    border: 1px solid #292929;
    border-radius: 8px;
}

#projectBrand {
    color: #EDEDED;
    font-size: 16px;
    font-weight: 500;
}

#projectSidebarVersion,
#projectSidebarCaption,
#projectPath,
#projectDate,
#projectBrowserSubtitle,
#dialogSubtitle,
#emptyStateSubtitle,
#templateDescription {
    color: #A1A1A1;
    font-size: 12px;
}

#projectBrowserTitle,
#dialogTitle {
    color: #EDEDED;
    font-size: 28px;
    font-weight: 500;
}

#projectSearch {
    background: #141414;
    padding: 10px 12px;
}

#projectList {
    background: transparent;
    border: none;
}

#projectRow {
    background: transparent;
    border: none;
    border-bottom: 1px solid #292929;
    border-radius: 0;
}

#projectRow:hover {
    background: #141414;
}

#projectRow[selected="true"] {
    background: #262626;
}

#projectName {
    color: #EDEDED;
    font-size: 14px;
    font-weight: 400;
}

#projectIcon,
#templateIcon {
    background: transparent;
    border: none;
}

#rendererBadge {
    background: #141414;
    border: none;
    border-radius: 4px;
    color: #A1A1A1;
    font-size: 10px;
    padding: 4px 7px;
}

#projectEmptyState {
    background: transparent;
    border: none;
}

#emptyStateTitle {
    color: #EDEDED;
    font-size: 20px;
    font-weight: 400;
}

QFrame[templateCard="true"] {
    background: #0A0A0A;
    border: 1px solid #2E2E2E;
    border-radius: 6px;
}

QFrame[templateCard="true"][selected="true"] {
    background: #262626;
    border-color: #EDEDED;
}

#templateOption,
#fieldLabel {
    color: #EDEDED;
    font-weight: 400;
}

#dialogError {
    color: #F87171;
    font-size: 12px;
}

#dialogHero {
    background: transparent;
    border: none;
    padding: 2px;
}

#dialogHeroIcon {
    background: transparent;
    border: none;
    padding: 4px;
}

#dialogHeroTitle {
    color: #EDEDED;
    font-size: 22px;
    font-weight: 500;
}

#exportSummary {
    background: #141414;
    border: none;
    border-radius: 6px;
    color: #A1A1A1;
    padding: 12px;
}

#exportLog,
#runtimeErrors {
    background: #0A0A0A;
    border: none;
    padding: 12px;
    font-family: "SF Mono", "Menlo", "Consolas";
    font-size: 12px;
    color: #EDEDED;
}

#commandPaletteDialog,
#globalSearchDialog {
    background: #141414;
    border: 1px solid #2E2E2E;
    border-radius: 6px;
}

#commandPaletteSearch,
#globalSearchField {
    background: transparent;
    border: none;
    border-bottom: 1px solid #2E2E2E;
    border-radius: 0;
    padding: 15px 12px;
    font-size: 16px;
}

#commandPaletteList,
#globalSearchResults {
    background: transparent;
    padding: 4px;
}

#paletteHint,
#projectListHint {
    background: transparent;
    color: #A1A1A1;
    font-size: 11px;
    padding: 7px 12px;
}

#splashCard {
    background: #0A0A0A;
    border: 1px solid #333333;
    border-radius: 8px;
}

#atlasSplash,
#splashIcon {
    background: transparent;
}

#splashTitle {
    color: #EDEDED;
    font-size: 36px;
    font-weight: 500;
}

#splashVersion,
#splashCompany,
#splashWarning {
    color: #A1A1A1;
    font-size: 12px;
}

#splashStatus {
    color: #EDEDED;
    font-size: 12px;
}

#splashProgress {
    background: #141414;
    border: none;
    min-height: 0;
    border-radius: 2px;
}

#splashProgress::chunk {
    background: #EDEDED;
    border-radius: 2px;
}

QPushButton:default {
    background: #EDEDED;
    color: #0A0A0A;
    border-color: #EDEDED;
}

#projectSectionLabel {
    color: #A1A1A1;
    font-size: 12px;
    padding: 3px 10px;
}

#searchPreviewPane {
    background: #0A0A0A;
    border: none;
    border-left: 1px solid #2E2E2E;
}

#searchPreviewText {
    background: transparent;
    border: none;
    padding: 0;
    font-family: "SF Mono", "Menlo", "Consolas";
    font-size: 12px;
    color: #EDEDED;
}

#projectRow[available="false"] #projectName {
    color: #A1A1A1;
}

QAbstractSpinBox QLineEdit {
    background: transparent;
    border: none;
    padding: 0;
    min-height: 0;
}

#inspectorVectorField {
    background: transparent;
    border: none;
}

#inspectorAxisField {
    background: #141414;
    border: 1px solid transparent;
    border-radius: 6px;
}

#inspectorAxisField:hover {
    background: #141414;
    border-color: #2E2E2E;
}

#inspectorAxisField QDoubleSpinBox {
    background: transparent;
    border: none;
    padding: 5px 2px;
    min-height: 24px;
}

#inspectorNumberField,
#inspectorNameField,
#inspectorColorText {
    min-height: 26px;
}

#inspectorAxisX,
#inspectorAxisY,
#inspectorAxisZ {
    padding: 0;
    font-size: 11px;
}

QTabBar::close-button {
    image: url(:/editor/assets/close.svg);
    width: 14px;
    height: 14px;
    padding: 5px;
    border-radius: 5px;
}

QTabBar::close-button:hover,
#tabCloseButton:hover,
#dockAreaCloseButton:hover {
    background: #262626;
}

QPushButton:default:hover {
    background: #FFFFFF;
}

QPushButton:default:pressed {
    background: #CCCCCC;
}

QPushButton:default:disabled {
    background: #262626;
    color: #707070;
    border-color: #333333;
}

ads--CDockWidgetTab[activeTab="true"] {
    background: #262626;
    border-radius: 6px;
}

QCheckBox:focus,
QRadioButton:focus {
    color: #52A8FF;
}

QSlider::handle:horizontal:focus {
    border: 1px solid #52A8FF;
}
