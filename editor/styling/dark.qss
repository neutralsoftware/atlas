* {
    font-family: "SF Pro Text", "Inter", "Segoe UI", "Arial";
    font-size: 13px;
    color: #C5C5BE;
    selection-background-color: #353532;
    selection-color: #F1F1EC;
}

QWidget {
    background: #191918;
}

QMainWindow,
QDialog,
#editorFrame,
#projectBrowserRoot {
    background: #121211;
}

QLabel,
QCheckBox,
QRadioButton,
QToolButton,
QPushButton {
    background: transparent;
}

QLabel:disabled {
    color: #62625D;
}

QLabel[muted="true"] {
    color: #92928B;
}

QPushButton,
QToolButton {
    border: none;
    border-radius: 7px;
    padding: 5px 10px;
    min-height: 24px;
}

QPushButton:hover,
QToolButton:hover {
    background: #292928;
}

QPushButton:checked,
QToolButton:checked {
    background: #30302E;
}

QPushButton:disabled,
QToolButton:disabled {
    color: #646460;
}

QToolButton::menu-indicator {
    image: none;
}

QLineEdit,
QTextEdit,
QPlainTextEdit {
    background: #20201F;
    border: 1px solid transparent;
    border-radius: 6px;
    padding: 7px 9px;
    selection-background-color: #42423E;
}

QLineEdit:hover,
QTextEdit:hover,
QPlainTextEdit:hover {
    background: #242423;
}

QLineEdit:focus,
QTextEdit:focus,
QPlainTextEdit:focus {
    border-color: #53534D;
}

QLineEdit:disabled,
QTextEdit:disabled,
QPlainTextEdit:disabled {
    color: #666660;
}

QComboBox,
QSpinBox,
QDoubleSpinBox,
QDateEdit,
QTimeEdit,
QDateTimeEdit {
    background: #252524;
    border: 1px solid transparent;
    border-radius: 5px;
    min-height: 24px;
    padding: 3px 8px;
    color: #D3D3CC;
}

QComboBox:hover,
QSpinBox:hover,
QDoubleSpinBox:hover {
    background: #2B2B29;
}

QComboBox:focus,
QSpinBox:focus,
QDoubleSpinBox:focus {
    border-color: #666660;
}

QComboBox:disabled,
QSpinBox:disabled,
QDoubleSpinBox:disabled {
    color: #666660;
}

QComboBox {
    padding-right: 28px;
}

QComboBox::drop-down {
    width: 26px;
    border: none;
}

QComboBox::down-arrow,
QAbstractSpinBox::down-arrow {
    image: url(:/editor/assets/chevron-down.svg);
    width: 12px;
    height: 12px;
}

QAbstractSpinBox::up-arrow {
    image: url(:/editor/assets/chevron-up.svg);
    width: 12px;
    height: 12px;
}

QAbstractSpinBox::up-button,
QAbstractSpinBox::down-button {
    background: transparent;
    border: none;
    width: 18px;
}

QComboBox QAbstractItemView {
    background: #222221;
    border: 1px solid #393936;
    border-radius: 8px;
    padding: 5px;
}

QCheckBox,
QRadioButton {
    spacing: 9px;
}

QCheckBox::indicator {
    width: 16px;
    height: 16px;
    border: 1px solid #55554F;
    border-radius: 4px;
    background: #232322;
}

QCheckBox::indicator:hover {
    border-color: #999991;
}

QCheckBox::indicator:checked {
    image: url(:/editor/assets/check.svg);
    background: #74746C;
    border-color: #999991;
}

QCheckBox::indicator:indeterminate {
    background: #999991;
    border: 4px solid #44443F;
}

QRadioButton::indicator {
    width: 16px;
    height: 16px;
    background: #232322;
    border: 1px solid #55554F;
    border-radius: 9px;
}

QRadioButton::indicator:checked {
    width: 8px;
    height: 8px;
    background: #DDDDD5;
    border: 5px solid #55554F;
    border-radius: 9px;
}

QSlider::groove:horizontal {
    height: 3px;
    background: #343431;
    border-radius: 1px;
}

QSlider::sub-page:horizontal {
    background: #93938A;
    border-radius: 1px;
}

QSlider::handle:horizontal {
    background: #D5D5CD;
    border: none;
    width: 10px;
    margin: -4px 0;
    border-radius: 5px;
}

QProgressBar {
    background: #292927;
    border: none;
    border-radius: 3px;
    min-height: 6px;
    text-align: center;
    color: #F1F1EC;
}

QProgressBar::chunk {
    background: #76766D;
    border-radius: 3px;
}

QScrollArea,
QAbstractScrollArea {
    background: #191918;
    border: none;
}

QAbstractScrollArea::corner {
    background: transparent;
}

QScrollBar:vertical {
    background: transparent;
    border: none;
    width: 8px;
    margin: 3px 1px;
}

QScrollBar:horizontal {
    background: transparent;
    border: none;
    height: 8px;
    margin: 1px 3px;
}

QScrollBar::handle:vertical,
QScrollBar::handle:horizontal {
    background: #3B3B36;
    border-radius: 3px;
    min-height: 32px;
    min-width: 32px;
}

QScrollBar::handle:vertical:hover,
QScrollBar::handle:horizontal:hover {
    background: #606059;
}

QScrollBar::add-line,
QScrollBar::sub-line,
QScrollBar::add-page,
QScrollBar::sub-page {
    border: none;
    background: transparent;
    width: 0;
    height: 0;
}

QTreeView,
QListView,
QTableView {
    background: #191918;
    border: none;
    outline: none;
    alternate-background-color: #1D1D1C;
    show-decoration-selected: 1;
}

QTreeView::item,
QListView::item,
QTableView::item {
    border: none;
    padding: 5px 8px;
}

QTreeView::item:selected,
QListView::item:selected,
QTableView::item:selected {
    background: #30302E;
    color: #F1F1EC;
}

QHeaderView::section {
    background: #191918;
    border: none;
    border-bottom: 1px solid #2B2B28;
    color: #92928B;
    padding: 9px;
    font-weight: 400;
}

QGroupBox {
    background: transparent;
    border: none;
    border-top: 1px solid #2B2B28;
    margin-top: 26px;
    padding: 14px 2px 6px 2px;
    font-weight: 500;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    padding: 0;
    color: #DDDDD6;
}

QTabWidget::pane {
    background: #191918;
    border: none;
}

QTabBar {
    background: transparent;
}

QTabBar::tab {
    background: transparent;
    border: none;
    color: #92928B;
    padding: 9px 16px;
    margin: 4px 3px;
    border-radius: 6px;
}

QTabBar::tab:selected {
    background: #2B2B29;
    color: #EAEAE3;
}

QTabBar::tab:hover {
    color: #EAEAE3;
}

QMenuBar {
    background: #121211;
    border: none;
    padding: 3px 10px;
}

QMenuBar::item {
    background: transparent;
    padding: 5px 9px;
}

QMenuBar::item:selected {
    background: #2B2B29;
    border-radius: 5px;
}

QMenu {
    background: #20201F;
    border: 1px solid #393936;
    border-radius: 8px;
    padding: 6px;
}

QMenu::item {
    background: transparent;
    padding: 9px 34px 9px 12px;
    border-radius: 5px;
}

QMenu::item:selected {
    background: #33332F;
}

QMenu::item:disabled {
    color: #64645E;
}

QMenu::separator {
    background: #343431;
    height: 1px;
    margin: 6px 10px;
}

QToolTip {
    background: #292927;
    color: #E1E1DA;
    border: 1px solid #44443E;
    border-radius: 5px;
    padding: 6px 9px;
}

QSplitter::handle {
    background: #121211;
}

QSplitter::handle:hover {
    background: #41413C;
}

QStatusBar {
    background: #121211;
    color: #888882;
    border: none;
    padding: 3px 14px;
    min-height: 24px;
    font-size: 11px;
}

QStatusBar::item {
    border: none;
}

#workspaceBar,
#workspaceChrome,
#workspaceIdentity,
#workspaceIdentityText,
#workspaceActivity,
#workspaceUtilities {
    background: #121211;
    border: none;
}

#workspaceBar {
    padding: 0;
    spacing: 0;
}

#workspaceProject {
    color: #D7D7D0;
    font-size: 13px;
}

#workspaceSwitcher,
#workspaceSurface,
#workspaceHeading,
#editorWorkspaceStack {
    background: #191918;
    border: none;
}

#workspaceHeading {
    border-bottom: 1px solid #282825;
}

#workspaceSwitcher {
    padding: 0;
}

#workspaceMark {
    background: transparent;
    border: none;
}

#workspaceContextPath,
#statusVersion,
#statusRenderer,
#statusRuntimeText,
#viewportFpsLabel,
#viewportShortcutHint {
    background: transparent;
    color: #898982;
    font-size: 11px;
    border: none;
}

#statusRuntime {
    background: transparent;
}

#sceneTabs {
    background: #191918;
    border: none;
}

#sceneTabs::tab {
    padding: 9px 14px;
    min-width: 92px;
}

#viewportTools {
    background: #191918;
}

#viewportToolbar,
#panelToolbar,
#materialEditorHeader,
#postProcessingToolbar,
#workspaceToolbar {
    background: #191918;
    border: none;
}

#hierarchySearch,
#contentSearchField {
    background: #222221;
    padding: 6px 9px;
}

#contentPathField {
    background: transparent;
    border: none;
    color: #A7A7A0;
}

#inspectorScroll,
#inspectorContent,
#materialEditorBody,
#postProcessingBody,
#environmentPages,
#environmentWorkspace,
#environmentPage {
    background: #191918;
    border: none;
}

#inspectorHeader {
    background: transparent;
    border: none;
    padding: 0;
}

#inspectorObjectIcon {
    background: transparent;
    border: none;
}

#inspectorNameField {
    background: transparent;
    border: 1px solid transparent;
    color: #EAEAE3;
    font-size: 18px;
    font-weight: 500;
    padding: 2px 0;
}

#inspectorNameField:focus {
    border-color: #55554F;
}

#inspectorTypeLabel,
#inspectorPropertyLabel,
#materialTexturePath,
#materialEditorStatus,
#postProcessingStatus,
#workspaceStatus,
#workspaceAutoApply {
    color: #93938C;
    font-size: 12px;
}

#inspectorComponent {
    background: transparent;
    border: none;
    border-top: 1px solid #2C2C29;
    border-radius: 0;
}

#inspectorComponentHeaderRow,
#inspectorComponentBody,
#inspectorPropertyRow,
#inspectorNestedGroup,
#inspectorAudioControls {
    background: transparent;
    border: none;
}

#inspectorVectorField,
#inspectorNumericField,
#inspectorColorField {
    background: #252524;
    border: none;
    border-radius: 5px;
}

#inspectorVectorField QDoubleSpinBox,
#inspectorNumericField QDoubleSpinBox {
    background: transparent;
    border: none;
    padding: 4px 2px;
}

#inspectorAxisX,
#inspectorAxisY,
#inspectorAxisZ {
    background: transparent;
    font-size: 10px;
    padding: 0 3px;
}

#inspectorAxisX { color: #CA9290; }
#inspectorAxisY { color: #9AB696; }
#inspectorAxisZ { color: #91A9C7; }

#inspectorColorSwatch {
    border: 1px solid #45453F;
    border-radius: 4px;
    padding: 2px;
}

#inspectorColorText {
    color: #B0B0A8;
    font-family: "SF Mono", "Menlo", "Consolas";
    font-size: 11px;
}

#inspectorNestedTitle,
#inspectorArrayTitle,
#materialTextureLabel {
    color: #C9C9C1;
    font-weight: 500;
}

#inspectorEmptyTitle,
#materialEditorEmpty,
#postProcessingEmpty {
    color: #C7C7BF;
    font-size: 15px;
    font-weight: 400;
}

#inspectorEmptyHint,
#environmentPageSubtitle,
#dialogHeroSubtitle {
    color: #92928B;
}

#materialEditorTitle,
#postProcessingTitle,
#postProcessingSectionTitle,
#workspaceTitle,
#inspectorCameraTitle {
    color: #D9D9D2;
    font-size: 13px;
    font-weight: 500;
}

#materialPreview {
    background: #151514;
    border: none;
    border-radius: 8px;
}

#materialTextureSlot {
    background: transparent;
    border: none;
    padding: 6px 0;
}

#materialTexturePreview {
    background: #242423;
    border: none;
    border-radius: 6px;
}

#environmentCategories {
    background: #191918;
    border: none;
    padding: 8px;
}

#environmentPageTitle {
    color: #E7E7E0;
    font-size: 22px;
    font-weight: 500;
}

ads--CDockContainerWidget,
ads--CDockContainerWidget > QSplitter,
ads--CDockContainerWidget ads--CDockSplitter::handle {
    background: #121211;
}

ads--CDockAreaWidget,
ads--CDockAreaWidget[focused="true"] {
    background: #191918;
    border: none;
    border-radius: 9px;
}

ads--CDockAreaTitleBar,
ads--CDockAreaWidget[focused="true"] ads--CDockAreaTitleBar {
    background: #191918;
    border: none;
    min-height: 40px;
}

#tabsContainerWidget {
    background: transparent;
}

ads--CDockWidgetTab,
ads--CDockWidgetTab[activeTab="true"],
ads--CDockWidgetTab[focused="true"] {
    background: transparent;
    border: none;
    padding: 3px 10px;
    margin: 3px;
}

ads--CDockWidgetTab #dockWidgetTabLabel {
    color: #A1A19A;
    font-size: 13px;
    padding: 4px 0;
}

ads--CDockWidgetTab[activeTab="true"] #dockWidgetTabLabel {
    color: #DADAD3;
}

ads--CTitleBarButton,
#tabCloseButton,
#dockAreaCloseButton,
#detachGroupButton,
#dockAreaAutoHideButton,
#dockAreaMinimizeButton,
#tabsMenuButton {
    background: transparent;
    border: none;
    padding: 4px;
    min-width: 18px;
    min-height: 18px;
}

ads--CTitleBarButton:hover,
#tabCloseButton:hover {
    background: #2B2B29;
    border-radius: 5px;
}

ads--CDockWidget {
    background: #191918;
}

ads--CAutoHideSideBar,
#sideTabsContainerWidget {
    background: #121211;
}

ads--CAutoHideTab {
    background: transparent;
    border: none;
    padding: 7px;
}

#projectSidebar {
    background: #121211;
    border: none;
}

#projectBrowserContent {
    background: #191918;
    border: none;
    border-radius: 10px;
}

#projectBrand {
    color: #E7E7E0;
    font-size: 16px;
    font-weight: 500;
}

#projectSidebarVersion,
#projectSidebarCaption,
#projectPath,
#projectDate,
#projectBrowserSubtitle,
#dialogSubtitle,
#emptyStateSubtitle,
#templateDescription {
    color: #92928B;
    font-size: 12px;
}

#projectBrowserTitle,
#dialogTitle {
    color: #EAEAE4;
    font-size: 28px;
    font-weight: 500;
}

#projectSearch {
    background: #222221;
    padding: 10px 12px;
}

#projectList {
    background: transparent;
    border: none;
}

#projectRow {
    background: transparent;
    border: none;
    border-radius: 7px;
}

#projectRow:hover {
    background: #242423;
}

#projectRow[selected="true"] {
    background: #30302E;
}

#projectName {
    color: #DEDED7;
    font-size: 14px;
    font-weight: 400;
}

#projectIcon,
#templateIcon {
    background: transparent;
    border: none;
}

#rendererBadge {
    background: #262624;
    border: none;
    border-radius: 4px;
    color: #ABABA2;
    font-size: 10px;
    padding: 4px 7px;
}

#projectEmptyState {
    background: transparent;
    border: none;
}

#emptyStateTitle {
    color: #CFCFC7;
    font-size: 20px;
    font-weight: 400;
}

QFrame[templateCard="true"] {
    background: #20201F;
    border: 1px solid transparent;
    border-radius: 8px;
}

QFrame[templateCard="true"][selected="true"] {
    background: #2A2A28;
    border-color: #66665F;
}

#templateOption,
#fieldLabel {
    color: #BDBDB5;
    font-weight: 400;
}

#dialogError {
    color: #D69C95;
    font-size: 12px;
}

#dialogHero {
    background: transparent;
    border: none;
    padding: 2px;
}

#dialogHeroIcon {
    background: transparent;
    border: none;
    padding: 4px;
}

#dialogHeroTitle {
    color: #E3E3DB;
    font-size: 22px;
    font-weight: 500;
}

#exportSummary {
    background: #1D1D1C;
    border: none;
    border-radius: 6px;
    color: #9C9C94;
    padding: 12px;
}

#exportLog,
#runtimeErrors {
    background: #161615;
    border: none;
    padding: 12px;
    font-family: "SF Mono", "Menlo", "Consolas";
    font-size: 12px;
    color: #C3BAB1;
}

#commandPaletteDialog,
#globalSearchDialog {
    background: #191918;
    border: 1px solid #373733;
    border-radius: 10px;
}

#commandPaletteSearch,
#globalSearchField {
    background: transparent;
    border: none;
    border-bottom: 1px solid #30302C;
    border-radius: 0;
    padding: 15px 12px;
    font-size: 16px;
}

#commandPaletteList,
#globalSearchResults {
    background: transparent;
    padding: 4px;
}

#paletteHint,
#projectListHint {
    background: transparent;
    color: #7E7E77;
    font-size: 11px;
    padding: 7px 12px;
}

#splashCard {
    background: #191918;
    border: 1px solid #343430;
    border-radius: 12px;
}

#atlasSplash,
#splashIcon {
    background: transparent;
}

#splashTitle {
    color: #ECECE6;
    font-size: 36px;
    font-weight: 500;
}

#splashVersion,
#splashCompany,
#splashWarning {
    color: #91918A;
    font-size: 12px;
}

#splashStatus {
    color: #BFBFB7;
    font-size: 12px;
}

#splashProgress {
    background: #2C2C28;
    border: none;
    min-height: 0;
    border-radius: 2px;
}

#splashProgress::chunk {
    background: #BCBCB2;
    border-radius: 2px;
}

QPushButton:default {
    background: #E5E5E1;
    color: #191918;
}
