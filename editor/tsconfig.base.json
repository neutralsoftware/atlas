{
    "compilerOptions": {
        "target": "ES2022",
        "strict": true,
        "noUncheckedIndexedAccess": true,
        "exactOptionalPropertyTypes": true,
        "skipLibCheck": true,
        "resolveJsonModule": true,
        "isolatedModules": true,
        "paths": {
            "src/*": ["./src/*"],
            "@shared/*": ["./src/shared/*"]
        }
    }
}
